{
    "compilerOptions": {
        "noEmit": true,
        "skipLibCheck": true,
        "noEmitOnError": true,
        "outDir": "./build/",
        "rootDir": "./src/",
        "module": "Node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "target": "es2022",
        "lib": ["es2022", "dom"],
        "sourceMap": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["build/**", "node_modules/**"]
}
